DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=true
DJANGO_USE_SQLITE=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Production: set DEBUG=false, use a long private secret, and configure HTTPS.
DJANGO_SECURE_SSL_REDIRECT=true
# Set HSTS only after confirming HTTPS works for the whole site.
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=false
# Omit DATABASE_URL to use SQLite for local development.
# DATABASE_URL=postgresql://sxcclubs:local-dev-password@localhost:5432/sxcclubs
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173
# On Render, set MEDIA_ROOT=/var/data/media after mounting a persistent disk at /var/data.
# Configure SMTP for password reset delivery outside local development.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=SXC Clubs <noreply@example.com>
